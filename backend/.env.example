# =============================================================================
# PencoLab Backend — variables para Render / local
# Copia a .env o configúralas en el panel de Render (Environment).
# =============================================================================

# Base de datos
# Local (SQLite):
DATABASE_URL=sqlite:///./pencolab.db
# Producción en Render (recomendado — SQLite se borra al reiniciar el dyno):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/pencolab

# JWT — usa una cadena larga y aleatoria en producción
JWT_SECRET=cambia-esta-clave-en-produccion
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# CORS — orígenes del frontend en Vercel (separados por coma, sin espacios de más)
# Ejemplo: https://pencolab.vercel.app,https://pencolab-git-main.vercel.app
CORS_ORIGINS=*

# Debug SQLAlchemy (dejar false en producción)
DEBUG=false

# Puerto (Render lo inyecta automáticamente como $PORT)
# PORT=8000
